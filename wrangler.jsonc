{
  "name": "riot-soldier-multiplayer",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",

  "durable_objects": {
    "bindings": [
      {
        "name": "RIOT_ROOM",
        "class_name": "RiotRoom"
      }
    ]
  },

  "exports": {
    "RiotRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RiotRoom"
      ]
    }
  ]
}
